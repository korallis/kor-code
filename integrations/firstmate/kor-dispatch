#!/usr/bin/env bash
# A stateless adapter. The Firstmate home owns polling, decisions and fleet state.
set -euo pipefail

usage() {
  echo 'Usage: kor-dispatch dispatch ISSUE-ID | poll EXECUTION-ID|ISSUE-ID | cancel EXECUTION-ID' >&2
  exit 2
}
[[ $# == 2 && -n $2 && $2 != -* ]] || usage
adapter_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
kor_bin=${KOR_BIN:-"$adapter_dir/../../bin/kor"}
command -v jq >/dev/null || { echo 'kor-dispatch requires jq' >&2; exit 1; }

case $1 in
  dispatch)
    "$kor_bin" run "$2" --json | jq -ce '
      if .schemaVersion != 1 or (.executionId | type) != "string" or (.executionId | length) == 0 then
        error("unsupported Kor dispatch response")
      else . + {dispatchType: "kor"} end'
    ;;
  cancel)
    "$kor_bin" cancel "$2" --json
    ;;
  poll)
    "$kor_bin" status --json "$2" | jq -ce '
      if .schemaVersion != 1 or .run == null then error("Kor execution unavailable") else . end
      | . as $response | .run as $run
      | (["complete", "failed", "canceled"] | index($run.state)) as $terminal
      | {
          schemaVersion: 1, dispatchType: "kor", executionId: $run.executionId,
          issueId: ($run.issueKey // $run.issueId), state: $run.state,
          provenance: .provenance, observedAt: .observedAt,
          fleetState: (if .provenance != "live" then "paused"
                       elif $run.needsInput != null then "needs-decision"
                       elif $run.state == "complete" then "done"
                       elif $run.state == "failed" then "failed"
                       elif $run.state == "canceled" then "canceled"
                       else "working" end),
          holdsCapacity: (.provenance != "live" or $terminal == null),
          pullRequestUrl: $run.pullRequestUrl, costUsd: $run.costUsd,
          cancelRequested: $run.cancelRequested,
          captainCall: (if .provenance == "live" and $run.needsInput != null then
            {key: ("kor:" + $run.executionId + ":" + ($run.attempts | tostring) + ":needs-input"), reason: $run.needsInput.reason}
            else null end),
          reason: ($response.reason // null)
        }'
    ;;
  *) usage ;;
esac
