{
  "name": "kor-code",
  "private": true,
  "version": "0.1.0",
  "description": "Kor Code foundation monorepo",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "bin": { "kor": "bin/kor" },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "probe": "tsx scripts/probe.ts",
    "kor": "pnpm --filter @kor-code/cli... build && tsx scripts/kor.ts",
    "models": "tsx scripts/models.ts",
    "gateway:quota-proof": "tsx scripts/gateway-quota-proof.ts",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json",
    "jev:fixture": "tsx scripts/jev-fixture.ts",
    "controller:fixture": "tsx scripts/controller-fixture.ts",
    "e2e:live": "tsx scripts/e2e-live.ts",
    "phase5:proof": "tsx scripts/phase5-proof.ts",
    "verification:proof": "tsx scripts/verification-proof.ts",
    "cockpit": "bash scripts/sandbox.sh --interactive",
    "cockpit:proof": "tsx scripts/cockpit-proof.ts",
    "isolation:proof": "bash scripts/isolation-proof.sh",
    "daemon:proof": "tsx scripts/daemon-proof.ts"
  },
  "devDependencies": {
    "@types/node": "^24.8.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
